{
    // =========================================================================
    // Конфигурация модуля проверки на читы (Admins.CheckCheats)
    // =========================================================================
    // ID текущего сервера в базе данных (используется в таблице checkcheats_stats)
    "server_id": 1,
    // Использовать ли базу данных MySQL для логирования проверок (1 - Да, 0 - Нет)
    "db_use": 1,
    // Автоматически переносить подозреваемого игрока в Наблюдатели и запрещать смену команды (1 - Да, 0 - Нет)
    "auto_move": 1,
    // Команды чата для вызова меню проверки
    "commands": "!check|!cheats",
    // Команда для ввода контактов (Discord / Telegram) подозреваемым
    "contact_command": "!contact",

    // -------------------------------------------------------------------------
    // Настройки таймера ответа и ввода социальных сетей
    // -------------------------------------------------------------------------
    "timer": {
        // Время в секундах, отводимое игроку на предоставление контактов (180 секунд)
        "time": 180,
        // Этап проверки, на котором начинается таймер (0 - вызов на проверку)
        "min": 0,
        // Этап проверки, на котором таймер отключается (2 - контакт отправлен, 3 - админ нажал "Начать проверку")
        "max": 2,
        // Банить ли автоматически по истечению таймера, если игрок не предоставил контакты (1 - Да, 0 - Нет)
        "auto_ban_status": 1,
        // Индекс причины бана из блока "reasons" при истечении таймера
        "auto_ban_reason": "3"
    },

    // -------------------------------------------------------------------------
    // Настройки при выходе игрока с сервера во время проверки
    // -------------------------------------------------------------------------
    "leave": {
        "player_ban_status": 1,
        "reason": "Покинул игру во время проверки",
        "reason2": "Выход из игры во время проверки на читы",
        "time": 0
    },

    // -------------------------------------------------------------------------
    // Причины завершения проверки
    // -------------------------------------------------------------------------
    // reason: Текст причины в меню и в базе данных
    // reason2: Текст причины при выдаче бана игроку
    // time: время бана в секундах (0 - навсегда, -1 - без бана, 86400 - 24 часа)
    // show: показывать ли пункт в интерактивном меню администратора (1 - Да, 0 - Нет)
    "reasons": {
        "0": {
            "reason": "Отказ от проверки",
            "reason2": "Игрок отказался от проверки",
            "time": 86400,
            "show": 1
        },
        "1": {
            "reason": "Использование читов",
            "reason2": "Игрок использовал читы",
            "time": 0,
            "show": 1
        },
        "2": {
            "reason": "Не использовал читы",
            "reason2": "",
            "time": -1,
            "show": 1
        },
        "3": {
            "reason": "Не указал социальную сеть",
            "reason2": "Игрок не указал социальную сеть",
            "time": 86400,
            "show": 0
        },
        "4": {
            "reason": "Миссклик",
            "reason2": "",
            "time": -1,
            "show": 1
        }
    },

    // -------------------------------------------------------------------------
    // Поддерживаемые социальные сети и ограничения по длине логина
    // -------------------------------------------------------------------------
    "socials": {
        "Telegram": {
            "min": 5,
            "max": 64,
            "example": "@stapi"
        },
        "Discord": {
            "min": 2,
            "max": 32,
            "example": "stapi"
        }
    }
}